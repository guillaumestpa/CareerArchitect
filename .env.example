# Supabase project settings — find these in your Supabase project's Settings > API page.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-side only (used by apps/worker), never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# LLM provider key for matching/scoring/drafting calls — provider still TBD (see docs project state, Open Questions).
LLM_API_KEY=
